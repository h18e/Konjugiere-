// Gemeinsame Einstellungen. Persönliche Werte (Team, Bundle-ID) gehören in Local.xcconfig,
// die nicht in Git landet. Vorlage: Local.xcconfig.example
KONJUGIERE_BUNDLE_ID = ch.raphaelhess.konjugiere
DEVELOPMENT_TEAM =

// Keine eigene Verschlüsselung (keine Netzwerkverbindung, nur lokale Daten).
// Erspart die Frage «Missing Compliance» in App Store Connect bei jedem Build.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

#include? "Local.xcconfig"
